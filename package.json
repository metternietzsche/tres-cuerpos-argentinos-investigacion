{
  "name": "tres-cuerpos-argentinos-investigacion",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate:routes",
    "generate:routes": "node scripts/generate-route-pages.mjs",
    "generate:whitepaper-pdf": "node scripts/generate-whitepaper-pdf.mjs",
    "generate:analysis": "node scripts/build-text-analysis-data.mjs",
    "release:build": "node scripts/build-release-archive.mjs",
    "release:verify": "node scripts/verify-release-archive.mjs",
    "test:static": "node scripts/validate-publication.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run generate:routes && npm run test:static && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1"
  }
}
